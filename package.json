{
  "name": "criprox",
  "version": "0.2.0",
  "private": true,
  "description": "A local card-sheet studio for Cricut Print Then Cut",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Go2Engle",
  "repository": {
    "type": "git",
    "url": "https://github.com/Go2Engle/CriProx.git"
  },
  "homepage": "https://github.com/Go2Engle/CriProx",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "desktop": "npm run build && electron .",
    "package": "npm run build && electron-builder --publish never",
    "package:mac": "npm run build && electron-builder --mac --universal --publish never",
    "package:windows": "npm run build && electron-builder --win --x64 --publish never",
    "package:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "format": "prettier --write src tests electron vite.config.ts"
  },
  "dependencies": {
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.2.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.criprox.studio",
    "productName": "CriProx",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "NOTICE",
      "!node_modules/@napi-rs/canvas{,/**/*}",
      "!node_modules/@napi-rs/canvas-*/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "icon": "build/icon.png"
  }
}
